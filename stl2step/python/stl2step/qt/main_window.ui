<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interface de STL2STEP au format Qt Designer : ouvrez ce fichier dans Qt Designer
  (designer, ou « pyqt6-tools designer ») pour la modifier, puis relancez l'appli.
  Le code retrouve les éléments par leur nom d'objet (objectName) : un élément
  supprimé est simplement ignoré ; un élément renommé perd son action.
  La zone « viewerHost » reçoit la vue 3D.
-->
